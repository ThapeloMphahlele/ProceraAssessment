@{
    ViewData["Title"] = "Contact";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>@ViewData["Title"]</h2>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h4 class="fw-bold text-primary">Procera Systems Support</h4>
                <p class="text-muted small">Developer Skills Assessment Project</p>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <h6 class="fw-bold text-dark mb-2">Technical Inquiries</h6>
                        <p class="text-secondary mb-1">Email Support</p>
                        <a href="mailto:support@procerasystems.mock" class="text-decoration-none fw-semibold">support@procerasystems.mock</a>
                    </div>
                    <div class="col-sm-6">
                        <h6 class="fw-bold text-dark mb-2">Fictitious Office</h6>
                        <p class="text-secondary mb-0">
                            123 Assessment Blvd<br />
                            Tech District, Floor 4<br />
                            Pretoria, South Africa
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>