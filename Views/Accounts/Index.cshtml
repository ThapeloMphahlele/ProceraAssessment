@model ProceraAssessment.ViewModels.AccountSearchViewModel

@{
    ViewData["Title"] = "Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>@ViewData["Title"]</h2>
    @* Intentionally omitting a global "Create Account" button here to enforce the business rule that accounts can only be added from a specific Person's details page. *@
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="mb-0">
            <div class="input-group">
                <input asp-for="SearchTerm" class="form-control"
                       placeholder="Search by Account Number or Person Surname..." />
                <button class="btn btn-outline-secondary" type="submit">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-danger">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="table-responsive shadow-sm">
    <table class="table table-striped table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>Account Number</th>
                <th>Person</th>
                <th>Balance</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Accounts.Any())
            {
                foreach (var account in Model.Accounts)
                {
                    <tr>
                        <td>@account.AccountNumber</td>
                        <td>@account.PersonName @account.PersonSurname</td>
                        <td>@account.OutstandingBalance.ToString("C2")</td>
                        <td>
                            @if (account.StatusName == "Open")
                            {
                                <span class="badge bg-success">@account.StatusName</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@account.StatusName</span>
                            }
                        </td>
                        <td class="text-end">
                            @* Placeholder link to the future Account Details page *@
                            <a asp-action="Edit" asp-route-id="@account.Code" class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4">No accounts found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>
</div>