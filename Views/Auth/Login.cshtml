@model ProceraAssessment.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">@ViewData["Title"]</h2>

                <form asp-controller="Auth" asp-action="Login" method="post">
                    @* Hidden field to carry the ReturnUrl through the POST request *@
                    <input type="hidden" asp-for="ReturnUrl" />

                    @* Displays generic controller-level errors *@
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        Login
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Includes the client-side jQuery validation scripts configured in the default MVC template *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}