@model ProceraAssessment.ViewModels.PersonSearchViewModel

@{
    ViewData["Title"] = "Persons";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Person</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="mb-0">
            <div class="input-group">
                <input asp-for="SearchTerm" class="form-control"
                       placeholder="Search by ID Number, Surname, or Account Number..." />
                <button class="btn btn-outline-secondary" type="submit">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-danger">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="table-responsive shadow-sm">
    <table class="table table-striped table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Surname</th>
                <th>ID Number</th>
                <th>Accounts</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Persons.Any())
            {
                foreach (var person in Model.Persons)
                {
                    <tr>
                        <td>@person.Code</td>
                        <td>@person.Name</td>
                        <td>@person.Surname</td>
                        <td>@person.IdNumber</td>
                        <td>
                            <span class="badge bg-info text-dark">@person.AccountCount</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@person.Code" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Delete" asp-route-id="@person.Code" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4">No persons found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@* --- Pagination Footer --- *@
<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 gap-3">
    <span class="text-muted small">
        Showing @Model.FirstItemOnPage&ndash;@Model.LastItemOnPage of @Model.TotalItems persons
    </span>
    
    @* Only render pagination controls if there is more than 1 page *@
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Persons pagination">
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                
                @* Previous Button *@
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                
                @* Page Numbers *@
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-page="@i">@i</a>
                    </li>
                }
                
                @* Next Button *@
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>