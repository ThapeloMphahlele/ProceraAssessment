@model ProceraAssessment.Models.Person

@{
    ViewData["Title"] = "Delete Person";
    // Enforce the business rule for the view display
    bool hasOpenAccounts = Model.Accounts.Any(a => a.AccountStatus.StatusName == "Open");
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>@ViewData["Title"]</h2>
</div>

@if (hasOpenAccounts)
{
    <div class="alert alert-danger shadow-sm" role="alert">
        <h5 class="alert-heading">Deletion Blocked</h5>
        <p class="mb-0">This person cannot be deleted because they have one or more <strong>Open</strong> accounts. All associated accounts must be closed before deletion is permitted.</p>
    </div>
    }
else
    {
        <div class="alert alert-warning shadow-sm" role="alert">
            <h5 class="alert-heading">Confirm Deletion</h5>
            <p class="mb-0">Are you sure you want to delete this person? All associated closed accounts and their transactions will also be permanently deleted.</p>
        </div>
    }

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Person Details</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.Code</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Name) ? "-" : Model.Name)</dd>

            <dt class="col-sm-3">Surname</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Surname) ? "-" : Model.Surname)</dd>

            <dt class="col-sm-3">ID Number</dt>
            <dd class="col-sm-9">@Model.IdNumber</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Associated Accounts</h5>
        <span class="badge bg-secondary">@Model.Accounts.Count</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Accounts.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Account Number</th>
                            <th>Outstanding Balance</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model.Accounts)
                        {
                            <tr>
                                <td class="ps-3">@account.AccountNumber</td>
                                <td>@account.OutstandingBalance.ToString("C2")</td>
                                <td>
                                    @if (account.AccountStatus.StatusName == "Open")
                                    {
                                        <span class="badge bg-success">@account.AccountStatus.StatusName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@account.AccountStatus.StatusName</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted text-center">
                This person has no associated accounts.
            </div>
        }
    </div>
</div>

<form asp-action="Delete" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" name="id" value="@Model.Code" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger" disabled="@(hasOpenAccounts ? "disabled" : null)">
            Delete Person
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>